# Normalise line endings in the repo; check out native on each platform.
# Without this every commit from Windows warns about LF -> CRLF conversion.
* text=auto eol=lf

# Windows-only tooling keeps CRLF so it runs correctly when checked out.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Never touch binaries.
*.png  binary
*.jpg  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.exe  binary

# Generated — collapse in diffs and exclude from language stats.
package-lock.json  linguist-generated=true -diff
