# ─────────────────────────────────────────────────────────────
# HireKit — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored — NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER SIDE ONLY, no NEXT_PUBLIC_ prefix.
# This bypasses RLS. Never expose to the browser.
# Found in: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Groq AI (required for AI features) ───────────────────────
# Found in: https://console.groq.com → API Keys
# Free tier: 14,400 req/day on Llama models. No credit card needed.
# SERVER SIDE ONLY — no NEXT_PUBLIC_ prefix.
GROQ_API_KEY=your-groq-api-key-here

# ── Google Calendar Sync (optional) ──────────────────────────
# 1. Go to https://console.cloud.google.com/ → create a project (or pick one)
# 2. APIs & Services → Library → enable "Google Calendar API"
# 3. APIs & Services → OAuth consent screen → set it up (External is fine for
#    personal use; add your own Google account as a test user)
# 4. APIs & Services → Credentials → Create Credentials → OAuth client ID
#    → Application type: Web application
#    → Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/calendar/google/callback
#      e.g. http://localhost:3000/api/calendar/google/callback for local dev
# 5. Copy the generated Client ID and Client Secret below.
# SERVER SIDE ONLY — no NEXT_PUBLIC_ prefix.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── WhatsApp Business API (optional) ─────────────────────────
# Required for WhatsApp job monitor feature
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token

# ── Social Media APIs (optional) ─────────────────────────────
# LinkedIn — https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# Meta (Instagram + Facebook) — https://developers.facebook.com/
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-page-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-account-id

# ── Email (optional, for sending emails) ─────────────────────
# Works with any SMTP provider (Gmail, Resend, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── App Config ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:3001
